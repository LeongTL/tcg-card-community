# Copy to env/dev.json, env/staging.json or env/prod.json (git-ignored) as JSON and run:
#   flutter run --flavor dev --dart-define-from-file=env/dev.json
# Only the project URL and the anon key go in the app. Never put the service-role key here.

FLAVOR=dev                      # dev | staging | prod
SUPABASE_URL=                   # dev: http://127.0.0.1:54321 (supabase start)
SUPABASE_ANON_KEY=              # public anon key of that project
